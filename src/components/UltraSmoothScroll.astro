---
// Ultra-smooth scrolling that will make users WOW!
---

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class UltraSmoothScroll {
    constructor() {
      this.initLenis();
      this.initScrollAnimations();
      this.initParallaxEffects();
      this.initMagneticElements();
    }

    initLenis() {
      // Ultra-smooth scrolling
      this.lenis = new Lenis({
        duration: 1.8,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        lerp: 0.05,
        smooth: true,
        direction: 'vertical',
        gestureDirection: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.2,
        touchMultiplier: 2,
        infinite: false,
      });

      // Connect with GSAP ScrollTrigger
      this.lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        this.lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    }

    initScrollAnimations() {
      // Reveal animations for sections
      gsap.utils.toArray('section').forEach((section) => {
        gsap.from(section, {
          y: 100,
          opacity: 0,
          duration: 1.5,
          ease: "power3.out",
          scrollTrigger: {
            trigger: section,
            start: "top 80%",
            end: "bottom 20%",
            toggleActions: "play none none reverse"
          }
        });
      });

      // Text reveal animations
      gsap.utils.toArray('.reveal-text').forEach((element) => {
        const splitText = element.textContent.split('');
        element.innerHTML = splitText.map(char => 
          char === ' ' ? ' ' : `<span style="display: inline-block; opacity: 0; transform: translateY(50px);">${char}</span>`
        ).join('');

        const chars = element.querySelectorAll('span');
        
        gsap.to(chars, {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "back.out(1.7)",
          stagger: 0.03,
          scrollTrigger: {
            trigger: element,
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        });
      });

      // Image parallax effect
      gsap.utils.toArray('.parallax-img').forEach((img) => {
        gsap.to(img, {
          yPercent: -50,
          ease: "none",
          scrollTrigger: {
            trigger: img,
            start: "top bottom",
            end: "bottom top",
            scrub: true
          }
        });
      });

      // Scale animations on scroll
      gsap.utils.toArray('.scale-on-scroll').forEach((element) => {
        gsap.fromTo(element, 
          { scale: 0.8, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 1.2,
            ease: "power2.out",
            scrollTrigger: {
              trigger: element,
              start: "top 85%",
              toggleActions: "play none none reverse"
            }
          }
        );
      });
    }

    initParallaxEffects() {
      // Background parallax layers
      gsap.utils.toArray('.parallax-bg').forEach((bg, index) => {
        const speed = (index + 1) * 0.5;
        gsap.to(bg, {
          yPercent: -50 * speed,
          ease: "none",
          scrollTrigger: {
            trigger: "body",
            start: "top top",
            end: "bottom bottom",
            scrub: true
          }
        });
      });

      // Floating elements
      gsap.utils.toArray('.float-element').forEach((element, index) => {
        gsap.to(element, {
          y: (index % 2 === 0 ? -1 : 1) * 100,
          rotation: (index % 2 === 0 ? 5 : -5),
          ease: "none",
          scrollTrigger: {
            trigger: element,
            start: "top bottom",
            end: "bottom top",
            scrub: 1
          }
        });
      });
    }

    initMagneticElements() {
      // Magnetic effect for buttons and cards
      gsap.utils.toArray('.magnetic').forEach((element) => {
        const magneticArea = element.getBoundingClientRect();
        
        element.addEventListener('mouseenter', () => {
          gsap.to(element, {
            scale: 1.05,
            duration: 0.3,
            ease: "power2.out"
          });
        });

        element.addEventListener('mouseleave', () => {
          gsap.to(element, {
            scale: 1,
            x: 0,
            y: 0,
            duration: 0.5,
            ease: "elastic.out(1, 0.3)"
          });
        });

        element.addEventListener('mousemove', (e) => {
          const { left, top, width, height } = element.getBoundingClientRect();
          const centerX = left + width / 2;
          const centerY = top + height / 2;
          const deltaX = (e.clientX - centerX) * 0.2;
          const deltaY = (e.clientY - centerY) * 0.2;

          gsap.to(element, {
            x: deltaX,
            y: deltaY,
            duration: 0.3,
            ease: "power2.out"
          });
        });
      });
    }

    // Method to scroll to specific section
    scrollTo(target) {
      this.lenis.scrollTo(target, {
        duration: 2,
        easing: (t) => 1 - Math.pow(1 - t, 3)
      });
    }

    // Destroy method for cleanup
    destroy() {
      this.lenis.destroy();
      ScrollTrigger.getAll().forEach(trigger => trigger.kill());
    }
  }

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    window.ultraSmoothScroll = new UltraSmoothScroll();
  });
</script>

<style>
  html.lenis, html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }
</style>
