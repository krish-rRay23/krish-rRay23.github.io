---
// <!-- Advanced Projects section with interactive 3D gallery -->
---

<section id="projects" class="relative py-20 overflow-hidden bg-white dark:bg-gray-900 transition-colors duration-300 sr-zoom">
	<!-- Clean gradient overlay for depth -->
	<div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-purple-50/30 to-white dark:from-gray-900 dark:via-blue-900/20 dark:to-gray-900"></div>

	<!-- Subtle animated grid background -->
	<div class="absolute inset-0 opacity-10 dark:opacity-20">
		<div class="absolute inset-0 bg-grid-pattern animate-grid-move"></div>
	</div>

	<!-- Floating glass morphism elements -->
	<div class="absolute inset-0 overflow-hidden pointer-events-none">
		<div class="glass-morph-clean absolute top-20 left-10 w-32 h-32 rounded-3xl animate-float-1"></div>
		<div class="glass-morph-clean absolute top-40 right-20 w-24 h-24 rounded-full animate-float-2"></div>
		<div class="glass-morph-clean absolute bottom-32 left-1/4 w-20 h-20 rounded-2xl animate-float-3"></div>
		<div class="glass-morph-clean absolute top-1/3 right-1/3 w-28 h-28 rounded-full animate-float-1"></div>
		<div class="glass-morph-gradient absolute bottom-20 right-10 w-40 h-40 rounded-3xl animate-float-2"></div>
	</div>

	<div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center mb-16">
			<h2 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
				Featured 
				<span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
					Projects
				</span>
			</h2>
			<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
				A showcase of my most impactful work, featuring robotics, agentic AI, and production-grade web systems
			</p>
			<div class="w-20 h-1 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full mx-auto mt-6"></div>
		</div>

		<!-- Projects Grid -->
		<div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			<!-- Project 1: DogBot -->
			<div class="project-card web fullstack group" data-aos="fade-up">
				<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
					<!-- Project Image -->
					<div class="relative h-48 bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 overflow-hidden">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-all duration-300"></div>
						<div class="absolute inset-0 flex items-center justify-center text-white">
							<div class="text-center">
								<svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"/>
								</svg>
								<div class="text-sm font-semibold">DogBot — Autonomous Mobile Manipulator</div>
							</div>
						</div>
						<!-- Hover Overlay -->
						<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-end">
							<div class="p-4 text-white">
								<div class="flex space-x-3">
									<a href="https://github.com/krish-rRay23/limo_cobot_documentation" target="_blank" rel="noopener" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition-colors" aria-label="GitHub">
										<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.9.58.1.79-.25.79-.56l-.02-2.02c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.3-1.69-1.3-1.69-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.77.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.28 1.2-3.09-.12-.29-.52-1.46.11-3.04 0 0 .98-.31 3.21 1.18a11.2 11.2 0 0 1 5.84 0c2.23-1.49 3.21-1.18 3.21-1.18.63 1.58.23 2.75.11 3.04.75.81 1.2 1.83 1.2 3.09 0 4.43-2.69 5.41-5.25 5.69.42.36.8 1.06.8 2.15l-.01 3.19c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
									</a>
									<a href="https://krish-rray23.github.io/limo_cobot_documentation/demo" target="_blank" rel="noopener" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition-colors" aria-label="Live Demo">
										<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/></svg>
									</a>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Project Content -->
					<div class="p-6">
						<div class="flex items-center justify-between mb-3">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white">DogBot — ROS2 + MyCobot + YOLOv8</h3>
							<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-xs">Featured</span>
						</div>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Production-grade autonomous robot: RTAB-Map SLAM, Nav2 waypointing, depth-to-map transforms, interrupt-safe mission control, and >95% pick-and-place accuracy using YOLOv8 and MyCobot 280.
						</p>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">ROS2</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">RTAB-Map</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Nav2</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">YOLOv8</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">MyCobot 280</span>
						</div>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2 text-gray-500 dark:text-gray-400">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/></svg>
								<span class="text-sm">5.0/5</span>
							</div>
							<a href="https://ipmdocs.netlify.app/" target="_blank" rel="noopener" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors duration-200">View Details</a>
						</div>
					</div>
				</div>
			</div>

				<!-- Project 2: HandSpeak.ai -->
				<div class="project-card fullstack" data-aos="fade-up" data-aos-delay="200">
					<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
						<div class="relative h-48 bg-gradient-to-br from-cyan-500 via-blue-500 to-indigo-500 overflow-hidden">
							<div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-all duration-300"></div>
							<div class="absolute inset-0 flex items-center justify-center text-white">
								<div class="text-center">
									<svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"/>
									</svg>
									<div class="text-sm font-semibold">HandSpeak.ai</div>
								</div>
							</div>
						</div>
						
						<div class="p-6">
							<div class="flex items-center justify-between mb-3">
								<h3 class="text-xl font-bold text-gray-900 dark:text-white">HandSpeak.ai</h3>
								<span class="px-2 py-1 bg-cyan-100 dark:bg-cyan-900 text-cyan-800 dark:text-cyan-200 rounded-full text-xs">CV</span>
							</div>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Real-time sign language recognition system converting gestures to text and speech with ~45ms latency. Privacy-first landmark-only vision pipeline with 95%+ accuracy, deployed via Docker and Kubernetes with CI/CD.
							</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">MediaPipe</span>
								<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Python</span>
								<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Docker</span>
								<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Kubernetes</span>
							</div>
							<div class="flex items-center justify-between">
								<div class="flex items-center space-x-2 text-gray-500 dark:text-gray-400">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/></svg>
									<span class="text-sm">5.0/5</span>
								</div>
								<a href="https://github.com/krish-rRay23/handSpeak.ai" target="_blank" rel="noopener" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg transition-colors duration-200">View Details</a>
							</div>
						</div>
					</div>
				</div>

			<!-- Project 3: Edge Deepfake Detection System -->
			<div class="project-card web" data-aos="fade-up" data-aos-delay="400">
				<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
					<div class="relative h-48 bg-gradient-to-br from-red-500 via-orange-500 to-yellow-500 overflow-hidden">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-all duration-300"></div>
						<div class="absolute inset-0 flex items-center justify-center text-white">
							<div class="text-center">
								<svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM5 19V5h14v14H5z"/>
								</svg>
								<div class="text-sm font-semibold">Edge Deepfake Detection</div>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="flex items-center justify-between mb-3">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white">Edge Deepfake Detection</h3>
							<span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded-full text-xs">ML</span>
						</div>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Edge-optimized deepfake detection pipeline using TinyCNN student model distilled from LaDeDa. Patch-level inference with aggregation, 8-bit quantization via TensorFlow Lite, and optional federated learning support.
						</p>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">TensorFlow Lite</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Model Distillation</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Federated Learning</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Edge AI</span>
						</div>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2 text-gray-500 dark:text-gray-400">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/></svg>
								<span class="text-sm">4.8/5</span>
							</div>
							<a href="https://github.com/krish-rRay23/Edge-Deepfake-Detection" target="_blank" rel="noopener" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg transition-colors duration-200">View Details</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Project 4: Agentic AI Orchestrator -->
			<div class="project-card fullstack" data-aos="fade-up" data-aos-delay="600">
				<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
					<div class="relative h-48 bg-gradient-to-br from-emerald-500 via-green-500 to-teal-500 overflow-hidden">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-all duration-300"></div>
						<div class="absolute inset-0 flex items-center justify-center text-white">
							<div class="text-center">
								<svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M17 2H7c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM7 4h10v16H7V4z"/>
								</svg>
								<div class="text-sm font-semibold">Agentic AI Orchestrator</div>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="flex items-center justify-between mb-3">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white">Agentic AI Orchestrator</h3>
							<span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-xs">Full Stack</span>
						</div>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Multi-agent AI orchestration system using LangGraph, LangChain, CrewAI, and AutoGen for autonomous task planning, execution, and monitoring with guardrails.
						</p>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">LangGraph</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">CrewAI</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Python</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">FastAPI</span>
						</div>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2 text-gray-500 dark:text-gray-400">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/></svg>
								<span class="text-sm">4.9/5</span>
							</div>
							<a href="https://github.com/krish-rRay23/automation_agents_service" target="_blank" rel="noopener" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors duration-200">View Details</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Project 5: PeerChain -->
			<div class="project-card web fullstack" data-aos="fade-up" data-aos-delay="800">
				<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
					<div class="relative h-48 bg-gradient-to-br from-indigo-600 via-purple-500 to-pink-500 overflow-hidden">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-all duration-300"></div>
						<div class="absolute inset-0 flex items-center justify-center text-white">
							<div class="text-center">
								<svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l20-10L2 2h18z"/>
								</svg>
								<div class="text-sm font-semibold">PeerChain</div>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="flex items-center justify-between mb-3">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white">PeerChain</h3>
							<span class="px-2 py-1 bg-indigo-100 dark:bg-indigo-900 text-indigo-800 dark:text-indigo-200 rounded-full text-xs">Web3</span>
						</div>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Decentralized scientific peer-review platform using smart contracts, IPFS, and LLMs to eliminate editor bias, enforce reviewer accountability via escrow incentives, and maintain transparent on-chain audit trails for research integrity.
						</p>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Smart Contracts</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">IPFS</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">LLMs</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Blockchain</span>
						</div>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2 text-gray-500 dark:text-gray-400">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/></svg>
								<span class="text-sm">4.7/5</span>
							</div>
							<a href="https://github.com/krish-rRay23/PeerChain" target="_blank" rel="noopener" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors duration-200">View Details</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Project 6: Bharat Health Pass -->
			<div class="project-card web fullstack" data-aos="fade-up" data-aos-delay="1000">
				<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
					<div class="relative h-48 bg-gradient-to-br from-rose-500 via-pink-500 to-red-500 overflow-hidden">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-all duration-300"></div>
						<div class="absolute inset-0 flex items-center justify-center text-white">
							<div class="text-center">
								<svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 9.5c0 .83-.67 1.5-1.5 1.5S11 13.33 11 12.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5zm5 4c-2.33-2.33-5.17-2.33-7.5 0v2h7.5v-2z"/>
								</svg>
								<div class="text-sm font-semibold">Bharat Health Pass</div>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="flex items-center justify-between mb-3">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white">Bharat Health Pass (BHP)</h3>
							<span class="px-2 py-1 bg-rose-100 dark:bg-rose-900 text-rose-800 dark:text-rose-200 rounded-full text-xs">FinTech</span>
						</div>
						<p class="text-gray-600 dark:text-gray-300 mb-4">
							Consent-driven, agent-orchestrated digital health access and settlement layer for India. Enables zero-upfront treatment via QR-based identity, automated eligibility checks, deferred settlement, insurance claim orchestration, fallback recovery, and immutable audit logs.
						</p>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">Agent Orchestration</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">FastAPI</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">PostgreSQL</span>
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">LLMs</span>
						</div>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2 text-gray-500 dark:text-gray-400">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/></svg>
								<span class="text-sm">4.8/5</span>
							</div>
							<a href="https://github.com/krish-rRay23/BharatHealthPass" target="_blank" rel="noopener" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-lg transition-colors duration-200">View Details</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Project 7: OfflinePay -->
			<div class="project-card web fullstack" data-aos="fade-up" data-aos-delay="1200">
