---
// Mind-blowing text animations that will make text come alive!
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class UltraTextAnimations {
    constructor() {
      this.initTypewriter();
      this.initGlitchText();
      this.initWaveText();
      this.initMorphingText();
      this.initParticleText();
      this.initRevealText();
    }

    initTypewriter() {
      const typewriterElements = document.querySelectorAll('.typewriter');
      
      typewriterElements.forEach(element => {
        const text = element.textContent;
        element.textContent = '';
        element.style.borderRight = '2px solid #3B82F6';
        
        let i = 0;
        const speed = 50;
        
        const typeWriter = () => {
          if (i < text.length) {
            element.textContent += text.charAt(i);
            i++;
            setTimeout(typeWriter, speed + Math.random() * 50);
          } else {
            // Blinking cursor effect
            setInterval(() => {
              element.style.borderRight = element.style.borderRight === '2px solid transparent' 
                ? '2px solid #3B82F6' 
                : '2px solid transparent';
            }, 500);
          }
        };
        
        // Start typing when element comes into view
        ScrollTrigger.create({
          trigger: element,
          start: "top 80%",
          onEnter: () => typeWriter()
        });
      });
    }

    initGlitchText() {
      const glitchElements = document.querySelectorAll('.glitch-text');
      
      glitchElements.forEach(element => {
        const originalText = element.textContent;
        const glitchChars = '!@#$%^&*()_+-=[]{}|;:,.<>?';
        
        element.addEventListener('mouseenter', () => {
          let iterations = 0;
          const maxIterations = 10;
          
          const glitchInterval = setInterval(() => {
            element.textContent = originalText
              .split('')
              .map((char, index) => {
                if (index < iterations) {
                  return originalText[index];
                }
                return glitchChars[Math.floor(Math.random() * glitchChars.length)];
              })
              .join('');
            
            iterations += 1;
            
            if (iterations > maxIterations) {
              clearInterval(glitchInterval);
              element.textContent = originalText;
            }
          }, 30);
        });
      });
    }

    initWaveText() {
      const waveElements = document.querySelectorAll('.wave-text');
      
      waveElements.forEach(element => {
        const text = element.textContent;
        element.innerHTML = text
          .split('')
          .map((char, index) => 
            char === ' ' ? ' ' : `<span style="display: inline-block; transition: transform 0.3s ease;">${char}</span>`
          )
          .join('');
        
        const spans = element.querySelectorAll('span');
        
        element.addEventListener('mouseenter', () => {
          spans.forEach((span, index) => {
            setTimeout(() => {
              span.style.transform = 'translateY(-10px) scale(1.1)';
              span.style.color = '#3B82F6';
              
              setTimeout(() => {
                span.style.transform = 'translateY(0) scale(1)';
                span.style.color = '';
              }, 200);
            }, index * 50);
          });
        });
      });
    }

    initMorphingText() {
      const morphElements = document.querySelectorAll('.morphing-text');
      
      morphElements.forEach(element => {
        const words = element.dataset.words.split(',');
        let currentWordIndex = 0;
        
        const morphText = () => {
          const currentWord = words[currentWordIndex];
          const nextWord = words[(currentWordIndex + 1) % words.length];
          
          // Split into characters
          const currentChars = currentWord.split('');
          const nextChars = nextWord.split('');
          const maxLength = Math.max(currentChars.length, nextChars.length);
          
          element.innerHTML = '';
          
          for (let i = 0; i < maxLength; i++) {
            const span = document.createElement('span');
            span.style.display = 'inline-block';
            span.style.transition = 'all 0.5s ease';
            span.textContent = currentChars[i] || '';
            element.appendChild(span);
          }
          
          const spans = element.querySelectorAll('span');
          
          // Animate to next word
          setTimeout(() => {
            spans.forEach((span, i) => {
              span.style.transform = 'rotateY(90deg)';
              
              setTimeout(() => {
                span.textContent = nextChars[i] || '';
                span.style.transform = 'rotateY(0deg)';
              }, 250);
            });
          }, 2000);
          
          currentWordIndex = (currentWordIndex + 1) % words.length;
        };
        
        morphText();
        setInterval(morphText, 4000);
      });
    }

    initParticleText() {
      const particleElements = document.querySelectorAll('.particle-text');
      
      particleElements.forEach(element => {
        element.addEventListener('click', () => {
          const rect = element.getBoundingClientRect();
          const particleCount = 50;
          
          for (let i = 0; i < particleCount; i++) {
            const particle = document.createElement('div');
            particle.style.position = 'fixed';
            particle.style.left = rect.left + rect.width / 2 + 'px';
            particle.style.top = rect.top + rect.height / 2 + 'px';
            particle.style.width = '4px';
            particle.style.height = '4px';
            particle.style.backgroundColor = '#3B82F6';
            particle.style.borderRadius = '50%';
            particle.style.pointerEvents = 'none';
            particle.style.zIndex = '9999';
            
            document.body.appendChild(particle);
            
            const angle = (i / particleCount) * Math.PI * 2;
            const velocity = 2 + Math.random() * 3;
            const vx = Math.cos(angle) * velocity;
            const vy = Math.sin(angle) * velocity;
            
            let x = 0;
            let y = 0;
            let opacity = 1;
            
            const animateParticle = () => {
              x += vx;
              y += vy;
              opacity -= 0.02;
              
              particle.style.transform = `translate(${x}px, ${y}px)`;
              particle.style.opacity = opacity;
              
              if (opacity > 0) {
                requestAnimationFrame(animateParticle);
              } else {
                particle.remove();
              }
            };
            
            requestAnimationFrame(animateParticle);
          }
        });
      });
    }

    initRevealText() {
      const revealElements = document.querySelectorAll('.reveal-text');
      
      revealElements.forEach(element => {
        const text = element.textContent;
        element.innerHTML = text
          .split('')
          .map(char => 
            char === ' ' ? ' ' : `<span style="display: inline-block; opacity: 0; transform: translateY(30px) rotateX(-90deg);">${char}</span>`
          )
          .join('');
        
        const spans = element.querySelectorAll('span');
        
        ScrollTrigger.create({
          trigger: element,
          start: "top 80%",
          onEnter: () => {
            gsap.to(spans, {
              opacity: 1,
              y: 0,
              rotationX: 0,
              duration: 0.6,
              ease: "back.out(1.7)",
              stagger: {
                amount: 0.8,
                from: "start"
              }
            });
          }
        });
      });
    }
  }

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new UltraTextAnimations();
  });
</script>

<style>
  .glitch-text {
    position: relative;
    font-weight: bold;
  }

  .glitch-text::before,
  .glitch-text::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .glitch-text::before {
    color: #ff0000;
    z-index: -1;
    animation: glitch-1 0.3s infinite;
  }

  .glitch-text::after {
    color: #00ff00;
    z-index: -2;
    animation: glitch-2 0.3s infinite;
  }

  @keyframes glitch-1 {
    0%, 14%, 15%, 49%, 50%, 99%, 100% {
      transform: translateX(0);
    }
    15%, 49% {
      transform: translateX(-2px);
    }
  }

  @keyframes glitch-2 {
    0%, 20%, 21%, 62%, 63%, 99%, 100% {
      transform: translateX(0);
    }
    21%, 62% {
      transform: translateX(2px);
    }
  }

  .morphing-text {
    font-family: 'JetBrains Mono', monospace;
    font-weight: bold;
    min-height: 1.2em;
  }

  .particle-text {
    cursor: pointer;
    user-select: none;
    transition: all 0.3s ease;
  }

  .particle-text:hover {
    transform: scale(1.05);
    text-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
  }
</style>
