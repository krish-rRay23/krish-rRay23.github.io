---
// Advanced Experience section with interactive timeline
---

<section id="experience" class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center mb-16">
			<h2 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
				My 
				<span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
					Journey
				</span>
			</h2>
			<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
				A timeline of my professional growth and key milestones in the world of technology
			</p>
			<div class="w-20 h-1 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full mx-auto mt-6"></div>
		</div>

		<!-- Interactive Timeline -->
		<div class="relative">
			<!-- Timeline Line -->
			<div class="absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-gradient-to-b from-blue-600 via-purple-600 to-pink-600 rounded-full"></div>
			
			<!-- Timeline Items -->
			<div class="space-y-12">
				<!-- Experience Item 1 -->
				<div class="timeline-item flex items-center" data-aos="fade-up">
					<div class="flex-1 pr-8 text-right">
						<div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
							<div class="flex items-center justify-end mb-3">
								<div class="text-sm text-blue-600 dark:text-blue-400 font-semibold">Today - Present</div>
							</div>
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Current Position</h3>
							<h4 class="text-lg text-blue-600 dark:text-blue-400 font-semibold mb-3">Your Company</h4>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								See You soon :)
							</p>
							<div class="flex flex-wrap gap-2 justify-end">
								<span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Python</span>
								<span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">C/C++</span>
								<span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full text-sm">Java</span>
								<span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded-full text-sm">React</span>
							</div>
						</div>
					</div>
					
					<!-- Timeline Dot -->
					<div class="relative z-10 w-4 h-4 bg-blue-600 rounded-full border-4 border-white dark:border-gray-900 shadow-lg"></div>
					
					<div class="flex-1 pl-8"></div>
				</div>

				<!-- Experience Item 2 -->
				<div class="timeline-item flex items-center" data-aos="fade-up" data-aos-delay="200">
					<div class="flex-1 pr-8"></div>
					
					<!-- Timeline Dot -->
					<div class="relative z-10 w-4 h-4 bg-purple-600 rounded-full border-4 border-white dark:border-gray-900 shadow-lg"></div>
					
					<div class="flex-1 pl-8">
						<div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
							<div class="flex items-center mb-3">
								<div class="text-sm text-purple-600 dark:text-purple-400 font-semibold">Jun 2025 - August 2025</div>
							</div>
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Research Intern – Robotics & AI</h3>
							<h4 class="text-lg text-purple-600 dark:text-purple-400 font-semibold mb-3">Hochschule Zittau/Goerlitz (IPM)</h4>
							<p class="text-gray-600 dark:text-gray-300 mb-4">Engineered a modular, production-grade autonomous robotics system (LIMO Pro + MyCobot280 + YOLOv11, ROS2) orchestrating a distributed network of custom nodes for advanced SLAM mapping, real-time 3D perception, and precision robotic manipulation, unified through a state-machine controller to enable fully automated exploration, high-fidelity object detection, intelligent pick-and-place, and seamless return-to-base workflows via a single-click deployment pipeline.

							</p>
							<div class="flex flex-wrap gap-2">
								<span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">Python</span>
								<span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Django</span>
								<span class="px-3 py-1 bg-pink-100 dark:bg-pink-900 text-pink-800 dark:text-pink-200 rounded-full text-sm">Selenium</span>
								<span class="px-3 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded-full text-sm">API Integration</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Experience Item 3 -->
				<div class="timeline-item flex items-center" data-aos="fade-up" data-aos-delay="400">
					<div class="flex-1 pr-8 text-right">
						<div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
							<div class="flex items-center justify-end mb-3">
								<div class="text-sm text-pink-600 dark:text-pink-400 font-semibold">Jun, 2024 - August, 2024</div>
							</div>
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Software Developer Intern</h3>
							<h4 class="text-lg text-pink-600 dark:text-pink-400 font-semibold mb-3">TechSolvo LLP</h4>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Developed and deployed AI-powered and web-based solutions, including a Django-based resume builder and advanced web-scraping automation pipelines using Selenium and BeautifulSoup4, enhancing data processing efficiency by 70%; engineered and optimised backend APIs, integrated relational databases, and delivered scalable, production-ready applications.
							</p>
							<div class="flex flex-wrap gap-2 justify-end">
								<span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded-full text-sm">JavaScript</span>
								<span class="px-3 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full text-sm">Express</span>
								<span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">MongoDB</span>
								<span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">HTML/CSS</span>
							</div>
						</div>
					</div>
					
					<!-- Timeline Dot -->
					<div class="relative z-10 w-4 h-4 bg-pink-600 rounded-full border-4 border-white dark:border-gray-900 shadow-lg"></div>
					
					<div class="flex-1 pl-8"></div>
				</div>

				<!-- Experience Item 4 -->
				<div class="timeline-item flex items-center" data-aos="fade-up" data-aos-delay="600">
					<div class="flex-1 pr-8"></div>
					
					<div class="relative z-10 w-4 h-4 bg-green-600 rounded-full border-4 border-white dark:border-gray-900 shadow-lg"></div>
					
					<div class="flex-1 pl-8">
						<div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
							<div class="flex items-center mb-3">
								<div class="text-sm text-green-600 dark:text-green-400 font-semibold">2023 - 2027</div>
							</div>
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">B.Tech in Computer Science and Engineering</h3>
							<h4 class="text-lg text-green-600 dark:text-green-400 font-semibold mb-3">Manipal University Jaipur</h4>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								Pursuing my B.Tech in Computer Science. Specialized in web technologies, 
								data structures, and software engineering principles.
							</p>
							<div class="flex flex-wrap gap-2">
								<span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Data Structures</span>
								<span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full text-sm">Algorithms</span>
								<span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">Software Engineering</span>
								<span class="px-3 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full text-sm">Database Systems</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Achievements Section -->
		<div class="mt-20">
			<h3 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">Key Achievements</h3>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="achievement-card bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl p-6 text-center transform hover:scale-105 transition-all duration-300">
					<div class="text-3xl font-bold mb-2">10+</div>
					<div class="text-blue-100">Projects Delivered</div>
				</div>
				<div class="achievement-card bg-gradient-to-br from-green-500 to-green-600 text-white rounded-xl p-6 text-center transform hover:scale-105 transition-all duration-300">
					<div class="text-3xl font-bold mb-2">5+</div>
					<div class="text-green-100">Team Members Mentored</div>
				</div>
				<div class="achievement-card bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-xl p-6 text-center transform hover:scale-105 transition-all duration-300">
					<div class="text-3xl font-bold mb-2">2+</div>
					<div class="text-purple-100">Awards Received</div>
				</div>
				<div class="achievement-card bg-gradient-to-br from-pink-500 to-pink-600 text-white rounded-xl p-6 text-center transform hover:scale-105 transition-all duration-300">
					<div class="text-3xl font-bold mb-2">10k+</div>
					<div class="text-pink-100">Users Impacted</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	.timeline-item {
		opacity: 0;
		animation: fade-up 0.8s ease-out forwards;
	}
	
	.achievement-card {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}
	
	.achievement-card:hover {
		transform: translateY(-8px) scale(1.05);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
	}
	
	/* Mobile Timeline Adjustments */
	@media (max-width: 768px) {
		.timeline-item {
			flex-direction: column;
		}
		
		.timeline-item .flex-1:first-child {
			padding-right: 0;
			padding-bottom: 1rem;
			text-align: left !important;
		}
		
		.timeline-item .flex-1:last-child {
			padding-left: 0;
			padding-top: 1rem;
		}
		
		.timeline-item .flex-1:last-child:empty {
			display: none;
		}
	}
</style>

<script>
	// Intersection Observer for timeline animation
	function initializeTimelineAnimation() {
		const timelineItems = document.querySelectorAll('.timeline-item');
		
		const observerOptions = {
			threshold: 0.3,
			rootMargin: '0px 0px -50px 0px'
		};
		
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.style.opacity = '1';
					entry.target.style.transform = 'translateY(0)';
					observer.unobserve(entry.target);
				}
			});
		}, observerOptions);
		
		timelineItems.forEach((item, index) => {
			item.style.transitionDelay = `${index * 0.2}s`;
			observer.observe(item);
		});
	}
	
	// Achievement counters animation
	function animateCounters() {
		const achievements = document.querySelectorAll('.achievement-card');
		
		const observerOptions = {
			threshold: 0.5
		};
		
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const target = entry.target.querySelector('.text-3xl');
					const finalNumber = parseInt(target.textContent);
					const suffix = target.textContent.replace(/[0-9]/g, '');
					
					let current = 0;
					const increment = finalNumber / 30;
					
					const timer = setInterval(() => {
						current += increment;
						if (current >= finalNumber) {
							current = finalNumber;
							clearInterval(timer);
						}
						target.textContent = Math.floor(current) + suffix;
					}, 50);
					
					observer.unobserve(entry.target);
				}
			});
		}, observerOptions);
		
		achievements.forEach(achievement => observer.observe(achievement));
	}
	
	// Initialize animations
	document.addEventListener('DOMContentLoaded', () => {
		initializeTimelineAnimation();
		animateCounters();
	});
</script>
