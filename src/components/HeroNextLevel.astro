---
// Clean, Professional Hero Section - Fast and Elegant
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-gray-900 via-blue-900 to-purple-900">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 20px 20px;"></div>
  </div>
  
  <!-- Simple floating elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-blue-400 rounded-full animate-pulse opacity-60"></div>
    <div class="absolute top-3/4 right-1/4 w-3 h-3 bg-purple-400 rounded-full animate-pulse opacity-40" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-1/3 left-1/6 w-2 h-2 bg-cyan-400 rounded-full animate-pulse opacity-50" style="animation-delay: 2s;"></div>
  </div>
  
  <!-- Main content -->
  <div class="relative z-20 text-center px-6 max-w-5xl mx-auto">
    <!-- Clean heading -->
    <div class="mb-8 space-y-4">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight">
        <div class="text-white mb-2 opacity-90">
          Hi, I'm Your
        </div>
        <div class="bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 bg-clip-text text-transparent text-5xl md:text-7xl lg:text-8xl font-black">
          Developer
        </div>
      </h1>
    </div>
    
    <!-- Professional subtitle -->
    <div class="mb-12 space-y-4">
      <p class="text-xl md:text-2xl text-gray-300 font-medium max-w-3xl mx-auto leading-relaxed">
        Creating exceptional digital experiences with modern web technologies
      </p>
      
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Full-stack developer passionate about building innovative solutions that make an impact
      </p>
    </div>
    
    <!-- INSANE CTA buttons with physics -->
    <div class="flex flex-col md:flex-row gap-8 justify-center items-center mb-20">
      <button class="magnetic scale-on-scroll group relative px-12 py-6 bg-gradient-to-r from-cyan-500 via-blue-600 to-purple-700 text-white font-black text-xl rounded-2xl overflow-hidden transition-all duration-500 hover:scale-110 hover:shadow-2xl hover:shadow-cyan-500/50 transform-gpu">
        <span class="relative z-10 particle-text flex items-center gap-3">
          <span>🔥 VIEW PORTFOLIO</span>
          <span class="animate-bounce">→</span>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-purple-700 via-pink-600 to-cyan-500 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute inset-0 bg-white/10 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700 skew-x-12"></div>
      </button>
      
      <button class="magnetic scale-on-scroll group relative px-12 py-6 border-3 border-white text-white font-black text-xl rounded-2xl overflow-hidden transition-all duration-500 hover:scale-110 hover:bg-white hover:text-gray-900 hover:shadow-2xl hover:shadow-white/50">
        <span class="relative z-10 wave-text flex items-center gap-3">
          <span>💬 HIRE ME NOW</span>
          <span class="animate-pulse">✨</span>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-white to-gray-100 translate-x-[-100%] group-hover:translate-x-0 transition-transform duration-500"></div>
      </button>
    </div>
    
    <!-- Enhanced scroll indicator -->
    <div class="absolute bottom-12 left-1/2 transform -translate-x-1/2">
      <div class="flex flex-col items-center space-y-4 animate-bounce">
        <div class="w-8 h-14 border-3 border-white/70 rounded-full flex justify-center backdrop-blur-sm">
          <div class="w-2 h-6 bg-gradient-to-b from-cyan-400 to-purple-600 rounded-full mt-3 animate-pulse"></div>
        </div>
        <p class="text-white/80 text-lg font-semibold reveal-text">SCROLL FOR MAGIC ✨</p>
        <div class="flex space-x-1">
          <div class="w-2 h-2 bg-cyan-400 rounded-full animate-bounce"></div>
          <div class="w-2 h-2 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.1s;"></div>
          <div class="w-2 h-2 bg-purple-600 rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Particle system overlay -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="particle-rain"></div>
  </div>
</section>

<style>
  /* Custom animations for NEXT LEVEL³ effects */
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }

  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-15px) scale(1.1); }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }

  @keyframes gradient-x {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  .animate-gradient-x {
    background-size: 200% 200%;
    animation: gradient-x 3s ease infinite;
  }

  /* Particle rain effect */
  .particle-rain::before,
  .particle-rain::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(2px 2px at 20px 30px, rgba(59, 130, 246, 0.3), transparent),
      radial-gradient(2px 2px at 40px 70px, rgba(147, 51, 234, 0.3), transparent),
      radial-gradient(1px 1px at 90px 40px, rgba(16, 185, 129, 0.3), transparent),
      radial-gradient(1px 1px at 130px 80px, rgba(245, 158, 11, 0.3), transparent),
      radial-gradient(2px 2px at 160px 30px, rgba(236, 72, 153, 0.3), transparent);
    background-repeat: repeat;
    background-size: 200px 100px;
    animation: particle-fall 20s linear infinite;
  }

  .particle-rain::after {
    animation-delay: -10s;
  }

  @keyframes particle-fall {
    to {
      transform: translateY(200vh);
    }
  }

  /* Enhanced magnetic effects */
  .magnetic {
    transition: all 0.3s cubic-bezier(0.23, 1, 0.320, 1);
  }

  .magnetic:hover {
    transform: translateY(-2px);
  }

  /* Glowing text effects */
  .glitch-text:hover {
    text-shadow: 
      0 0 5px currentColor,
      0 0 10px currentColor,
      0 0 15px currentColor,
      0 0 20px currentColor;
  }

  /* Custom gradient text with animation */
  .bg-clip-text {
    background-size: 200% 200%;
    animation: gradient-x 3s ease infinite;
  }
</style>

<script>
  // Enhanced typing effect for the hero
  document.addEventListener('DOMContentLoaded', () => {
    const words = ['DEVELOPER', 'DESIGNER', 'CREATOR', 'INNOVATOR', 'GENIUS'];
    const morphingElement = document.querySelector('.morphing-text');
    let currentIndex = 0;
    
    if (morphingElement) {
      setInterval(() => {
        currentIndex = (currentIndex + 1) % words.length;
        morphingElement.textContent = words[currentIndex];
        
        // Add extra glow effect on change
        morphingElement.style.textShadow = '0 0 30px rgba(147, 51, 234, 0.8)';
        setTimeout(() => {
          morphingElement.style.textShadow = '';
        }, 500);
      }, 3000);
    }
  });
</script>
