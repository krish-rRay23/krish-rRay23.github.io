							<path d="M12 3C7.58 3 4 4.79 4 7s3.58 4 8 4 8-1.79 8-4-3.58-4-8-4zM4 9v3c0 2.21 3.58 4 8 4s8-1.79 8-4V9c0 2.21-3.58 4-8 4s-8-1.79-8-4zM4 16v3c0 2.21 3.58 4 8 4s8-1.79 8-4v-3c0 2.21-3.58 4-8 4s-8-1.79-8-4z"/>
						</svg>
					</div>
					<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Web & APIs</h3>
					<p class="text-gray-600 dark:text-gray-400 text-sm">Django, FastAPI, React, Next.js, Astro</p>
				</div>
			</div>

			<div class="bg-white dark:bg-gray-900 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
				<div class="text-center">
					<div class="w-16 h-16 bg-gradient-to-r from-orange-500 to-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
						<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/>
						</svg>
					</div>
					<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Data, Cloud & Tools</h3>
					<p class="text-gray-600 dark:text-gray-400 text-sm">PostgreSQL/MySQL, AWS, Git/Linux, CI/CD</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script type="module">
	// Updated skills data for Krish Ray
	const skillsData = {
		robotics: [
			{ name: 'ROS2 / TF2', level: 92, color: 'from-blue-500 to-cyan-600', icon: '🤖' },
			{ name: 'SLAM / Nav2 / AMCL', level: 88, color: 'from-sky-500 to-indigo-600', icon: '🗺️' },
			{ name: 'Computer Vision (YOLOv8, OpenCV)', level: 90, color: 'from-teal-500 to-emerald-600', icon: '👁️' }
		],
		ai: [
			{ name: 'Transformers (LLaMA 3)', level: 85, color: 'from-fuchsia-500 to-pink-600', icon: '🧠' },
			{ name: 'LangGraph / CrewAI / Autogen', level: 88, color: 'from-purple-500 to-violet-600', icon: '🕸️' },
			{ name: 'NumPy / Pandas / Matplotlib', level: 90, color: 'from-emerald-500 to-teal-600', icon: '📊' }
		],
		web: [
			{ name: 'Django / DRF', level: 90, color: 'from-emerald-500 to-green-600', icon: '🧱' },
			{ name: 'FastAPI / Pydantic', level: 88, color: 'from-lime-500 to-emerald-600', icon: '⚡' },
			{ name: 'React / Next.js / Astro', level: 86, color: 'from-blue-500 to-indigo-700', icon: '🖥️' }
		],
		dataCloud: [
			{ name: 'PostgreSQL / MySQL / SQLite', level: 85, color: 'from-blue-500 to-sky-600', icon: '🗄️' },
			{ name: 'AWS Basics / Deployments', level: 78, color: 'from-yellow-500 to-orange-600', icon: '☁️' },
			{ name: 'Git / Linux / CI/CD', level: 95, color: 'from-slate-500 to-gray-700', icon: '🛠️' }
		]
	};

	function initializeSkills() {
		const container = document.getElementById('skills-container');
		if (!container) return;

		const tabsHtml = `
			<div class="flex flex-wrap justify-center mb-8 bg-white dark:bg-gray-900 rounded-full p-2 shadow-lg max-w-3xl mx-auto">
				<button class="skill-tab active px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="robotics">Robotics</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="ai">AI & Agents</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="web">Web & APIs</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="dataCloud">Data & Cloud</button>
			</div>
			<div id="skills-content" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
		`;

		container.innerHTML = tabsHtml;

		document.querySelectorAll('.skill-tab').forEach(tab => {
			tab.addEventListener('click', () => {
				const category = tab.dataset.category;
				switchSkillCategory(category);
				document.querySelectorAll('.skill-tab').forEach(t => t.classList.remove('active'));
				tab.classList.add('active');
			});
		});

		switchSkillCategory('robotics');
	}

	function switchSkillCategory(category) {
		const content = document.getElementById('skills-content');
		const skills = skillsData[category] || [];
		
		content.style.opacity = '0';
		content.style.transform = 'translateY(20px)';
		
		setTimeout(() => {
			content.innerHTML = skills.map(skill => `
				<div class="skill-card bg-white dark:bg-gray-900 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
					<div class="flex items-center justify-between mb-4">
						<div class="flex items-center space-x-3">
							<span class="text-2xl">${skill.icon}</span>
							<h3 class="text-lg font-semibold text-gray-900 dark:text-white">${skill.name}</h3>
						</div>
						<span class="text-sm text-gray-500 dark:text-gray-400 font-medium">${skill.level}%</span>
					</div>
					<div class="relative">
						<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3">
							<div class="bg-gradient-to-r ${skill.color} h-3 rounded-full skill-progress transition-all duration-1000 ease-out" style="width: 0%"></div>
						</div>
					</div>
				</div>
			`).join('');
			
			content.style.opacity = '1';
			content.style.transform = 'translateY(0)';
			
			setTimeout(() => {
				document.querySelectorAll('.skill-progress').forEach((bar, index) => {
					setTimeout(() => {
						bar.style.width = skills[index].level + '%';
					}, index * 100);
				});
			}, 200);
		}, 150);
	}

	document.addEventListener('DOMContentLoaded', initializeSkills);
</script>

<style>
	.skill-tab {
		@apply text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400;
	}
	.skill-tab.active {
		@apply bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg;
	}
	.skill-card {
		transition: all 0.3s ease;
	}
	.skill-card:hover {
		transform: translateY(-8px) scale(1.02);
	}
	#skills-content {
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
</style>
