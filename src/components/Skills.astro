<script type="module">
	// Updated comprehensive skills data for Krish Ray
	const skillsData = {
		languages: [
			{ name: 'Python', level: 95, color: 'from-blue-500 to-cyan-600', icon: '🐍' },
			{ name: 'C++', level: 88, color: 'from-blue-600 to-indigo-700', icon: '⚡' },
			{ name: 'Java', level: 85, color: 'from-orange-500 to-red-600', icon: '☕' },
			{ name: 'SQL', level: 90, color: 'from-blue-400 to-blue-600', icon: '🗄️' },
			{ name: 'MATLAB', level: 82, color: 'from-orange-400 to-red-500', icon: '📊' },
			{ name: 'JavaScript', level: 88, color: 'from-yellow-400 to-orange-500', icon: '🟨' }
		],
		frameworks: [
			{ name: 'FastAPI', level: 90, color: 'from-teal-500 to-cyan-600', icon: '⚡' },
			{ name: 'Django', level: 88, color: 'from-green-500 to-emerald-600', icon: '🧱' },
			{ name: 'PyTorch', level: 88, color: 'from-red-500 to-orange-600', icon: '🔥' },
			{ name: 'LangGraph', level: 85, color: 'from-purple-500 to-pink-600', icon: '🧠' },
			{ name: 'OpenCV', level: 92, color: 'from-red-500 to-pink-600', icon: '📷' },
			{ name: 'NumPy & Pandas', level: 92, color: 'from-blue-400 to-cyan-500', icon: '📊' }
		],
		storage: [
			{ name: 'Qdrant', level: 85, color: 'from-purple-500 to-indigo-600', icon: '🎯' },
			{ name: 'Neo4j', level: 82, color: 'from-blue-500 to-cyan-600', icon: '🔗' },
			{ name: 'Redis', level: 88, color: 'from-red-500 to-orange-600', icon: '⚡' },
			{ name: 'REST APIs', level: 92, color: 'from-green-500 to-teal-600', icon: '🌐' },
			{ name: 'CI/CD Pipelines', level: 87, color: 'from-blue-600 to-indigo-700', icon: '🔄' }
		],
		infrastructure: [
			{ name: 'Docker', level: 90, color: 'from-blue-600 to-indigo-700', icon: '🐳' },
			{ name: 'Kubernetes', level: 85, color: 'from-blue-500 to-cyan-600', icon: '☸️' },
			{ name: 'Supabase', level: 82, color: 'from-green-500 to-emerald-600', icon: '🗄️' },
			{ name: 'PostgreSQL', level: 92, color: 'from-blue-400 to-blue-600', icon: '🗃️' },
			{ name: 'Linux & Git', level: 95, color: 'from-orange-500 to-red-600', icon: '🐧' }
		],
		concepts: [
			{ name: 'Data Structures & Algorithms', level: 92, color: 'from-purple-500 to-indigo-600', icon: '🏗️' },
			{ name: 'Object-Oriented Programming', level: 95, color: 'from-blue-500 to-cyan-600', icon: '🔧' },
			{ name: 'Operating Systems', level: 85, color: 'from-gray-500 to-gray-700', icon: '💻' },
			{ name: 'Database Management', level: 88, color: 'from-green-500 to-teal-600', icon: '💾' },
			{ name: 'Computer Networks', level: 82, color: 'from-indigo-500 to-purple-600', icon: '🌐' },
			{ name: 'Cryptography', level: 80, color: 'from-red-500 to-pink-600', icon: '🔐' },
			{ name: 'Machine Learning', level: 90, color: 'from-yellow-500 to-orange-600', icon: '🤖' },
			{ name: 'Deep Learning', level: 88, color: 'from-pink-500 to-rose-600', icon: '🧮' },
			{ name: 'Computer Vision', level: 92, color: 'from-cyan-500 to-blue-600', icon: '👁️' },
			{ name: 'Natural Language Processing', level: 87, color: 'from-violet-500 to-purple-600', icon: '📝' }
		]
	};

	function initializeSkills() {
		const container = document.getElementById('skills-container');
		if (!container) return;

		const tabsHtml = `
			<div class="flex flex-wrap justify-center mb-8 bg-white dark:bg-gray-900 rounded-full p-2 shadow-lg max-w-4xl mx-auto">
				<button class="skill-tab active px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="languages">Languages</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="frameworks">Frameworks & Core</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="storage">Data & Orchestration</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="infrastructure">Infrastructure</button>
				<button class="skill-tab px-6 py-3 rounded-full font-semibold transition-all duration-300" data-category="concepts">Concepts</button>
			</div>
			<div id="skills-content" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
		`;

		container.innerHTML = tabsHtml;

		document.querySelectorAll('.skill-tab').forEach(tab => {
			tab.addEventListener('click', () => {
				const category = tab.dataset.category;
				switchSkillCategory(category);
				document.querySelectorAll('.skill-tab').forEach(t => t.classList.remove('active'));
				tab.classList.add('active');
			});
		});

		switchSkillCategory('languages');
	}

	function switchSkillCategory(category) {
		const content = document.getElementById('skills-content');
		const skills = skillsData[category] || [];
		
		content.style.opacity = '0';
		content.style.transform = 'translateY(20px)';
		
		setTimeout(() => {
			content.innerHTML = skills.map(skill => `
				<div class="skill-card bg-white dark:bg-gray-900 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
					<div class="flex items-center justify-between mb-4">
						<div class="flex items-center space-x-3">
							<span class="text-2xl">${skill.icon}</span>
							<h3 class="text-lg font-semibold text-gray-900 dark:text-white">${skill.name}</h3>
						</div>
						<span class="text-sm text-gray-500 dark:text-gray-400 font-medium">${skill.level}%</span>
					</div>
					<div class="relative">
						<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3">
							<div class="bg-gradient-to-r ${skill.color} h-3 rounded-full skill-progress transition-all duration-1000 ease-out" style="width: 0%"></div>
						</div>
					</div>
				</div>
			`).join('');
			
			content.style.opacity = '1';
			content.style.transform = 'translateY(0)';
			
			setTimeout(() => {
				document.querySelectorAll('.skill-progress').forEach((bar, index) => {
					setTimeout(() => {
						bar.style.width = skills[index].level + '%';
					}, index * 100);
				});
			}, 200);
		}, 150);
	}

	document.addEventListener('DOMContentLoaded', initializeSkills);
</script>

<style>
	.skill-tab {
		@apply text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400;
	}
	.skill-tab.active {
		@apply bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg;
	}
	.skill-card {
		transition: all 0.3s ease;
	}
	.skill-card:hover {
		transform: translateY(-8px) scale(1.02);
	}
	#skills-content {
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	/* Background grid animation */
	.bg-grid-pattern {
		background-image: 
			linear-gradient(rgba(59, 130, 246, 0.1) 1px, transparent 1px),
			linear-gradient(90deg, rgba(59, 130, 246, 0.1) 1px, transparent 1px);
		background-size: 50px 50px;
	}

	.animate-grid-move {
		animation: gridMove 20s linear infinite;
	}

	@keyframes gridMove {
		0% { transform: translate(0, 0); }
		100% { transform: translate(50px, 50px); }
	}

	/* Glass morphism effects - Clean Theme */
	.glass-morph-clean {
		background: rgba(59, 130, 246, 0.1);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(59, 130, 246, 0.2);
		box-shadow: 0 8px 32px rgba(59, 130, 246, 0.1);
	}

	.glass-morph-gradient {
		background: rgba(147, 51, 234, 0.1);
		backdrop-filter: blur(15px);
		border: 1px solid rgba(147, 51, 234, 0.2);
		box-shadow: 0 12px 40px rgba(147, 51, 234, 0.15);
	}

	/* Dark mode adjustments */
	.dark .glass-morph-clean {
		background: rgba(59, 130, 246, 0.05);
		border: 1px solid rgba(59, 130, 246, 0.15);
	}

	.dark .glass-morph-gradient {
		background: rgba(147, 51, 234, 0.05);
		border: 1px solid rgba(147, 51, 234, 0.15);
	}

	/* Floating animations */
	.animate-float-1 {
		animation: float1 6s ease-in-out infinite;
	}

	.animate-float-2 {
		animation: float2 8s ease-in-out infinite;
	}

	.animate-float-3 {
		animation: float3 10s ease-in-out infinite;
	}

	@keyframes float1 {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-30px) rotate(180deg); }
	}

	@keyframes float2 {
		0%, 100% { transform: translateX(0px) translateY(0px); }
		33% { transform: translateX(20px) translateY(-20px); }
		66% { transform: translateX(-20px) translateY(-10px); }
	}

	@keyframes float3 {
		0%, 100% { transform: scale(1) rotate(0deg); }
		50% { transform: scale(1.1) rotate(90deg); }
	}
</style>
