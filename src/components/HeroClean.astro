---
// Professional Advanced Hero Section - Sophisticated & Visually Appealing
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-white dark:bg-gray-900 transition-colors duration-300">
  <!-- Clean gradient overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-purple-50/30 to-white dark:from-gray-900 dark:via-blue-900/20 dark:to-gray-900"></div>
  
  <!-- Subtle animated grid background -->
  <div class="absolute inset-0 opacity-10 dark:opacity-20">
    <div class="absolute inset-0 bg-grid-pattern animate-grid-move"></div>
  </div>
  
  <!-- Floating glass morphism elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="glass-morph-clean absolute top-20 left-10 w-32 h-32 rounded-3xl animate-float-1"></div>
    <div class="glass-morph-clean absolute top-40 right-20 w-24 h-24 rounded-full animate-float-2"></div>
    <div class="glass-morph-clean absolute bottom-32 left-1/4 w-20 h-20 rounded-2xl animate-float-3"></div>
    <div class="glass-morph-clean absolute top-1/3 right-1/3 w-28 h-28 rounded-full animate-float-1"></div>
    <div class="glass-morph-gradient absolute bottom-20 right-10 w-40 h-40 rounded-3xl animate-float-2"></div>
  </div>
  
  <!-- Main content with advanced typography -->
  <div class="relative z-20 text-center px-6 max-w-6xl mx-auto">
    <!-- Professional heading with advanced effects -->
    <div class="mb-12 space-y-6">
      <!-- Greeting with fade-in -->
      <div class="fade-in-up" style="animation-delay: 0.2s;">
        <p class="text-lg md:text-xl text-blue-600 dark:text-blue-400 font-medium tracking-wider uppercase">
          Robotics • AI/ML • Full-Stack
        </p>
      </div>
      
      <!-- Main heading with gradient and glow -->
      <div class="fade-in-up" style="animation-delay: 0.4s;">
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight">
          <div class="text-gray-900 dark:text-white mb-3 relative" style="margin-top: 51px;">
            Hi, I'm 
            <span class="highlight-text relative">Your</span>
          </div>
          <span class="gradient-text-clean text-6xl md:text-8xl lg:text-9xl">
            developer- Krish
          </span>
        </h1>
      </div>
      
      <!-- Dynamic role with typewriter effect -->
      <div class="fade-in-up" style="animation-delay: 0.6s;">
        <div class="text-2xl md:text-3xl text-gray-600 dark:text-gray-300 font-semibold h-12 flex items-center justify-center">
          <span id="role-text" class="typewriter-text"></span>
          <span class="cursor-blink ml-1">|</span>
        </div>
      </div>
    </div>
    
    <!-- Sophisticated subtitle -->
    <div class="mb-16 space-y-6 fade-in-up" style="animation-delay: 0.8s;">
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 font-medium max-w-4xl mx-auto leading-relaxed">
         I build autonomous robots, agentic AI systems, and production-grade web services that ship.
      </p>
      
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-3xl mx-auto">
        ROS2 • SLAM • YOLO • LangGraph • CrewAI • Django/FastAPI • React/Next • AWS • PostgreSQL
      </p>
    </div>
    
    <!-- Premium CTA buttons with advanced effects -->
    <div class="flex flex-col sm:flex-row gap-8 justify-center items-center mb-20 fade-in-up" style="animation-delay: 1s;">
      <a href="#projects" class="cta-primary-clean group relative px-10 py-5 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-blue-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <span class="relative z-10 flex items-center gap-3 text-white font-bold text-lg">
          <span>View My Portfolio</span>
          <svg class="w-5 h-5 transform group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </span>
        <div class="absolute inset-0 bg-white/20 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700 skew-x-12 rounded-xl"></div>
      </a>
      
      <a href="#contact" class="cta-secondary-clean group relative px-10 py-5">
        <div class="absolute inset-0 border-2 border-blue-600/30 dark:border-blue-400/30 rounded-xl backdrop-blur-sm bg-blue-50/50 dark:bg-blue-900/20 group-hover:border-blue-600/50 dark:group-hover:border-blue-400/50 group-hover:bg-blue-100/50 dark:group-hover:bg-blue-800/30 transition-all duration-300"></div>
        <span class="relative z-10 flex items-center gap-3 text-blue-600 dark:text-blue-400 font-bold text-lg">
          <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <span>Let's Connect</span>
        </span>
      </a>
    </div>
    
    <!-- Elegant scroll indicator -->
    <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 fade-in-up" style="animation-delay: 1.2s;">
      <div class="flex flex-col items-center space-y-3">
        <div class="scroll-indicator relative w-8 h-14 border-2 border-blue-600/40 dark:border-blue-400/40 rounded-full backdrop-blur-sm">
          <div class="absolute top-3 left-1/2 transform -translate-x-1/2 w-1 h-4 bg-gradient-to-b from-blue-600 to-purple-600 rounded-full animate-scroll-down"></div>
        </div>
        <p class="text-gray-600 dark:text-gray-400 text-sm font-medium tracking-wide">Discover More</p>
      </div>
    </div>
  </div>
  
  <!-- Particle connections overlay -->
  <canvas id="particle-canvas" class="absolute inset-0 pointer-events-none opacity-40"></canvas>
</section>

<style>
  /* Advanced animations and effects */
  
  /* Background grid animation */
  .bg-grid-pattern {
    background-image: 
      linear-gradient(rgba(59, 130, 246, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 130, 246, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
  }
  
  .animate-grid-move {
    animation: gridMove 20s linear infinite;
  }
  
  @keyframes gridMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }
  
  /* Glass morphism effects - Clean Theme */
  .glass-morph-clean {
    background: rgba(59, 130, 246, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(59, 130, 246, 0.2);
    box-shadow: 0 8px 32px rgba(59, 130, 246, 0.1);
  }
  
  .glass-morph-gradient {
    background: rgba(147, 51, 234, 0.1);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(147, 51, 234, 0.2);
    box-shadow: 0 12px 40px rgba(147, 51, 234, 0.15);
  }
  
  /* Dark mode adjustments */
  .dark .glass-morph-clean {
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.15);
  }
  
  .dark .glass-morph-gradient {
    background: rgba(147, 51, 234, 0.05);
    border: 1px solid rgba(147, 51, 234, 0.15);
  }
  
  /* Floating animations */
  .animate-float-1 {
    animation: float1 6s ease-in-out infinite;
  }
  
  .animate-float-2 {
    animation: float2 8s ease-in-out infinite;
  }
  
  .animate-float-3 {
    animation: float3 10s ease-in-out infinite;
  }
  
  @keyframes float1 {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-30px) rotate(180deg); }
  }
  
  @keyframes float2 {
    0%, 100% { transform: translateX(0px) translateY(0px); }
    33% { transform: translateX(20px) translateY(-20px); }
    66% { transform: translateX(-20px) translateY(-10px); }
  }
  
  @keyframes float3 {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.1) rotate(90deg); }
  }
  
  /* Advanced text effects - Clean Theme */
  .gradient-text-clean {
    background: linear-gradient(135deg, #2563eb, #7c3aed, #2563eb, #7c3aed);
    background-size: 300% 300%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShiftClean 4s ease infinite;
  }
  
  @keyframes gradientShiftClean {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .highlight-text::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 30%, rgba(59, 130, 246, 0.3) 50%, transparent 70%);
    animation: highlightClean 3s ease infinite;
  }
  
  @keyframes highlightClean {
    0%, 100% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
  }
  
  /* Typewriter effect - Clean Theme */
  .typewriter-text {
    border-right: 2px solid #2563eb;
    animation: typing 4s steps(20, end) infinite;
  }
  
  .cursor-blink {
    animation: blinkClean 1s infinite;
    color: #2563eb;
  }
  
  @keyframes blinkClean {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  /* Dark mode typewriter */
  .dark .typewriter-text {
    border-right-color: #60a5fa;
  }
  
  .dark .cursor-blink {
    color: #60a5fa;
  }
  
  /* Fade in animations */
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s ease forwards;
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* CTA button effects - Clean Theme */
  .cta-primary-clean {
    transform: translateY(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
  }
  
  .cta-primary-clean:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.4);
  }
  
  .cta-secondary-clean {
    transform: translateY(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 20px rgba(59, 130, 246, 0.15);
  }
  
  .cta-secondary-clean:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(59, 130, 246, 0.25);
  }
  
  /* Scroll indicator animation */
  .animate-scroll-down {
    animation: scrollDown 2s ease-in-out infinite;
  }
  
  @keyframes scrollDown {
    0% { opacity: 0; transform: translate(-50%, -10px); }
    50% { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%, 10px); }
  }
  
  /* Performance optimizations */
  .glass-morph-clean,
  .glass-morph-gradient,
  .cta-primary-clean,
  .cta-secondary-clean {
    will-change: transform;
    backface-visibility: hidden;
  }
</style>

<script>
  // Advanced interactions and animations
  document.addEventListener('DOMContentLoaded', () => {
    // Typewriter effect for roles
    const roles = ['Full-Stack Developer', 'Robotics Engineer', 'AI/ML Specialist', 'Problem Solver', 'Tech Innovator'];
    const roleElement = document.getElementById('role-text');
    let roleIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    
    function typeWriter() {
      const currentRole = roles[roleIndex];
      
      if (isDeleting) {
        roleElement.textContent = currentRole.substring(0, charIndex - 1);
        charIndex--;
      } else {
        roleElement.textContent = currentRole.substring(0, charIndex + 1);
        charIndex++;
      }
      
      let typeSpeed = isDeleting ? 50 : 100;
      
      if (!isDeleting && charIndex === currentRole.length) {
        typeSpeed = 2000;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        typeSpeed = 500;
      }
      
      setTimeout(typeWriter, typeSpeed);
    }
    
    typeWriter();
    
    // Particle connection animation
    const canvas = document.getElementById('particle-canvas');
    const ctx = canvas.getContext('2d');
    
    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    
    const particles = [];
    const particleCount = 60;
    
    // Create particles
    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        size: Math.random() * 2 + 1
      });
    }
    
    function drawParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = 'rgba(59, 130, 246, 0.6)';
      ctx.strokeStyle = 'rgba(59, 130, 246, 0.2)';
      ctx.lineWidth = 1;
      
      particles.forEach((particle, i) => {
        // Update position
        particle.x += particle.vx;
        particle.y += particle.vy;
        
        // Bounce off edges
        if (particle.x < 0 || particle.x > canvas.width) particle.vx *= -1;
        if (particle.y < 0 || particle.y > canvas.height) particle.vy *= -1;
        
        // Draw particle
        ctx.beginPath();
        ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        ctx.fill();
        
        // Draw connections
        particles.slice(i + 1).forEach(otherParticle => {
          const dx = particle.x - otherParticle.x;
          const dy = particle.y - otherParticle.y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < 100) {
            ctx.beginPath();
            ctx.moveTo(particle.x, particle.y);
            ctx.lineTo(otherParticle.x, otherParticle.y);
            ctx.stroke();
          }
        });
      });
      
      requestAnimationFrame(drawParticles);
    }
    
    drawParticles();
    
    // Smooth scroll for CTA buttons
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  });
</script>
