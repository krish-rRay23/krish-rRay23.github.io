					<!-- Background Decoration -->
					<div class="absolute -z-10 top-8 left-8 w-full h-full bg-gradient-to-br from-blue-100 to-purple-100 dark:from-blue-900/20 dark:to-purple-900/20 rounded-2xl"></div>
