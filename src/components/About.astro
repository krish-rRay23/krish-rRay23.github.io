</section>

<style>
	@keyframes float-gentle {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-10px); }
	}
	.floating-element {
		animation: float-gentle 3s ease-in-out infinite;
	}
	.skill-bar {
		transition: width 2s ease-in-out;
	}
	/* Scroll-reveal Netflix-style fade/zoom utility classes */
	.sr-reveal {
		opacity: 0;
		transform: translateY(40px) scale(0.96);
		transition:
			opacity 0.7s cubic-bezier(0.4,0,0.2,1),
			transform 0.7s cubic-bezier(0.4,0,0.2,1);
		transition-delay: var(--sr-delay,0ms);
		will-change: opacity, transform;
	}
	.sr-reveal.sr-visible {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.sr-card {
		opacity: 0;
		transform: translateY(40px) scale(0.96);
		transition:
			opacity 0.7s cubic-bezier(0.4,0,0.2,1),
			transform 0.7s cubic-bezier(0.4,0,0.2,1);
		transition-delay: var(--sr-delay,0ms);
		will-change: opacity, transform;
	}
	.sr-card.sr-visible {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.sr-zoom {
		opacity: 0;
		transform: scale(0.98);
		transition:
			opacity 0.9s cubic-bezier(0.4,0,0.2,1),
			transform 0.9s cubic-bezier(0.4,0,0.2,1);
		will-change: opacity, transform;
	}
	.sr-zoom.sr-visible {
		opacity: 1;
		transform: scale(1);
	}
	@media (prefers-reduced-motion: reduce) {
		.sr-reveal, .sr-card, .sr-zoom {
			transition: none !important;
		}
	}

	/* Background grid animation */
	.bg-grid-pattern {
		background-image: 
			linear-gradient(rgba(59, 130, 246, 0.1) 1px, transparent 1px),
			linear-gradient(90deg, rgba(59, 130, 246, 0.1) 1px, transparent 1px);
		background-size: 50px 50px;
	}

	.animate-grid-move {
		animation: gridMove 20s linear infinite;
	}

	@keyframes gridMove {
		0% { transform: translate(0, 0); }
		100% { transform: translate(50px, 50px); }
	}

	/* Glass morphism effects - Clean Theme */
	.glass-morph-clean {
		background: rgba(59, 130, 246, 0.1);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(59, 130, 246, 0.2);
		box-shadow: 0 8px 32px rgba(59, 130, 246, 0.1);
	}

	.glass-morph-gradient {
		background: rgba(147, 51, 234, 0.1);
		backdrop-filter: blur(15px);
		border: 1px solid rgba(147, 51, 234, 0.2);
		box-shadow: 0 12px 40px rgba(147, 51, 234, 0.15);
	}

	/* Dark mode adjustments */
	.dark .glass-morph-clean {
		background: rgba(59, 130, 246, 0.05);
		border: 1px solid rgba(59, 130, 246, 0.15);
	}

	.dark .glass-morph-gradient {
		background: rgba(147, 51, 234, 0.05);
		border: 1px solid rgba(147, 51, 234, 0.15);
	}

	/* Floating animations */
	.animate-float-1 {
		animation: float1 6s ease-in-out infinite;
	}

	.animate-float-2 {
		animation: float2 8s ease-in-out infinite;
	}

	.animate-float-3 {
		animation: float3 10s ease-in-out infinite;
	}

	@keyframes float1 {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-30px) rotate(180deg); }
	}

	@keyframes float2 {
		0%, 100% { transform: translateX(0px) translateY(0px); }
		33% { transform: translateX(20px) translateY(-20px); }
		66% { transform: translateX(-20px) translateY(-10px); }
	}

	@keyframes float3 {
		0%, 100% { transform: scale(1) rotate(0deg); }
		50% { transform: scale(1.1) rotate(90deg); }
	}
</style>

<script>
// Scroll-reveal Netflix-style animation engine
function scrollRevealInit() {
	const revealEls = document.querySelectorAll('.sr-reveal, .sr-card, .sr-zoom');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (prefersReducedMotion) {
		revealEls.forEach(el => el.classList.add('sr-visible'));
		return;
	}
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('sr-visible');
			} else {
				entry.target.classList.remove('sr-visible');
			}
		});
	}, { threshold: 0.3 });
	revealEls.forEach(el => observer.observe(el));
}

// Counter animation (only when visible)
function animateCounters() {
	const counters = document.querySelectorAll('.sr-card .counter');
	counters.forEach(counterEl => {
		let started = false;
		const parent = counterEl.closest('.sr-card');
		const target = parseInt(parent.dataset.target);
		const increment = target / 50;
		let current = 0;
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting && !started) {
					started = true;
					const timer = setInterval(() => {
						current += increment;
						if (current >= target) {
							current = target;
							clearInterval(timer);
						}
						counterEl.textContent = Math.floor(current) + (target > 99 ? '+' : '');
					}, 40);
				}
				if (!entry.isIntersecting && started) {
					// Optionally reset counter if you want reverse animation
				}
			});
		}, { threshold: 0.7 });
		observer.observe(parent);
	});
}

// Skill bars animation (only when visible)
function animateSkillBars() {
	const skillItems = document.querySelectorAll('.skill-item');
	skillItems.forEach(item => {
		let animated = false;
		const skillBar = item.querySelector('.skill-bar');
		const skillPercentage = item.dataset.skill;
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting && !animated) {
					animated = true;
					setTimeout(() => {
						skillBar.style.width = skillPercentage + '%';
					}, 200);
				}
				if (!entry.isIntersecting && animated) {
					// Optionally reset bar if you want reverse animation
				}
			});
		}, { threshold: 0.5 });
		observer.observe(item);
	});
}

document.addEventListener('DOMContentLoaded', () => {
	scrollRevealInit();
	animateCounters();
	animateSkillBars();
});
</script>
