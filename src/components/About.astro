							<path d="M12 2l3.09 6.26L22 9l-5 4.87 1.18 6.88L12 17.77l-6.18 2.98L7 14.87 2 10l6.91-1.74L12 2z"/>
						</svg>
					</div>
					<div class="absolute top-1/2 -right-8 w-12 h-12 bg-green-500 rounded-full flex items-center justify-center text-white shadow-lg floating-element animation-delay-2000">
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
