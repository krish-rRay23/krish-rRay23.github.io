			</div>
			<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
				<div class="bg-gradient-to-r from-pink-400 to-red-500 h-2 rounded-full skill-bar" style="width: 0%"></div>
			</div>
		</div>
		<div class="skill-item sr-card" style="--sr-delay:320ms" data-skill="85">
